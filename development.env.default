# Environment variables needed for running this project.
# Copy this file to .env in this directory for it to be picked up automatically.

# Tell docker-compose to use this project's yml file by default.
COMPOSE_FILE=docker-compose.yml
COMPOSE_PROJECT_NAME=rails-backend-template

## [DN] Docker environment variables
## The blank ones should match docker-compose.yml when deployed to production
APP_HOME=/app
RAILS_ENV=development

# Keep everything below this sorted!

CI=
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5000
EDITOR=vim
POSTGRES_DB=rails-backend-template
POSTGRES_HOST=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_POOL=5
POSTGRES_PORT=5432
POSTGRES_USER=postgres
RACK_CORS_DEBUG=disabled
RAILS_MASTER_KEY=leave_this_unchanged_since_we_do_not_use_rails_creds
REDIS_URL=redis://redis:6379
WEB_CONCURRENCY=0
