# Environment variables needed for running this project.
# Copy this file to .env in this directory for it to be picked up automatically.

## [DN] Docker environment variables
## The blank ones should match docker-compose.yml when deployed to production
DISTRO_NAME=
RUBY_VERSION=
PG_MAJOR=
APP_HOME=/app
RAILS_ENV=production

# Keep everything below this sorted!

CORS_ORIGINS=
EDITOR=vim
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_POOL=25
POSTGRES_PORT=5432
POSTGRES_USER=
RAILS_LOG_LEVEL=warn
RAILS_MASTER_KEY=leave_this_unchanged_since_we_do_not_use_rails_creds
REDIS_URL=redis://redis:6379
SECRET_KEY_BASE= ##[DN] Run `bundle exec rails secret`
WEB_CONCURRENCY=5